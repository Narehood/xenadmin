<Project>
	<PropertyGroup>
		<!-- Multi-target libraries use net8.0 (not net8.0-windows) for Avalonia; Windows-only APIs are runtime-gated. -->
		<NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);CA1416</NoWarn>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<AssemblyTitle>$(Title)</AssemblyTitle>
		<AssemblyDescription>$(Description)</AssemblyDescription>
		<Copyright>Copyright © XCP-ng</Copyright>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/xcp-ng/xenadmin</RepositoryUrl>
		<RevisionNumber>$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("D3"))</RevisionNumber>
		<Authors>XCP-ng</Authors>
		<Product>XCP-ng Center</Product>
		<YearVer>0</YearVer>
		<MonthVer>0</MonthVer>
		<PatchVer>0</PatchVer>
		<Version>$(YearVer).$(MonthVer).$(PatchVer).$(RevisionNumber)</Version>
		<FileVersion>$(YearVer).$(MonthVer).$(PatchVer).$(RevisionNumber)</FileVersion>
		<Codename>Medicine Hat</Codename>
		<Lab>xcpngcenter_main</Lab>
	</PropertyGroup>
</Project>
