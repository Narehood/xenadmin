<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net481;net10.0</TargetFrameworks>
		<Title>XenCenterLib</Title>
		<Description>XCP-ng Center library</Description>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\LICENSE" LogicalName="XenCenterLib.LICENSE" />
		<EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="XenCenterLib.THIRD-PARTY-NOTICES.txt" />
		<PackageReference Include="SharpZipLib" />
		<PackageReference Include="log4net" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net481'">
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.Management" />
		<Reference Include="System.Security" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Management" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" />
	</ItemGroup>
</Project>
