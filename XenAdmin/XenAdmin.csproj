<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputType>WinExe</OutputType>
		<AssemblyName>XCP-ng Center</AssemblyName>
		<ApplicationIcon>AppIcon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Title>XCP-ng Center</Title>
		<Description>XCP-ng Center</Description>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<!-- WinForms .resx still embed BinaryFormatter payloads (ImageList/ListView groups); migrate later. -->
		<GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\XenModel\XenModel.csproj" />
		<ProjectReference Include="..\XenCenterLib\XenCenterLib.csproj" />
		<ProjectReference Include="..\XenOvfApi\XenOvfApi.csproj" />
		<ProjectReference Include="..\CommandLib\CommandLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Management" />
		<PackageReference Include="System.Configuration.ConfigurationManager" />
		<PackageReference Include="System.Security.Permissions" />
		<PackageReference Include="System.Resources.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="AxMSTSCLib">
			<HintPath>RDP\AxMSTSCLib.dll</HintPath>
		</Reference>
		<Reference Include="MSTSCLib">
			<HintPath>RDP\MSTSCLib.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="VNC\KeyMap.resx">
			<LogicalName>DotNetVnc.KeyMap.resources</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Update="Wizards\NewSRWizard_Pages\ChooseSrProvisioningPage.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>ChooseSrProvisioningPage.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Wizards\NewSRWizard_Pages\ChooseSrProvisioningPage.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>ChooseSrProvisioningPage.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<PropertyGroup>
		<_AxImpExe Condition="'$(_AxImpExe)' == '' and Exists('$(TargetFrameworkSDKToolsDirectory)aximp.exe')">$(TargetFrameworkSDKToolsDirectory)aximp.exe</_AxImpExe>
		<_AxImpExe Condition="'$(_AxImpExe)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8.1 Tools\aximp.exe')">$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8.1 Tools\aximp.exe</_AxImpExe>
		<_AxImpExe Condition="'$(_AxImpExe)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\aximp.exe')">$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\aximp.exe</_AxImpExe>
	</PropertyGroup>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(SkipRdpAxImp)' != 'true'">
		<Error Condition="'$(_AxImpExe)' == '' or !Exists('$(_AxImpExe)')" Text="aximp.exe not found. Install the .NET Framework 4.8/4.8.1 targeting pack / VS Desktop workload, or set _AxImpExe / SkipRdpAxImp=true when interop DLLs already exist." />
		<Exec Command="&quot;$(_AxImpExe)&quot; $(WinDir)\System32\mstscax.dll" WorkingDirectory="$(ProjectDir)RDP" />
	</Target>
</Project>
