<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:XcpNgCenter.Shell.Controls"
             x:Class="XcpNgCenter.Shell.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- ShellThemeManager supplies the live light/dark and accent palette. -->
      <FontFamily x:Key="Font.Outfit">avares://XcpNgCenter.Shell/Assets/Fonts/Outfit-Regular.ttf#Outfit,avares://XcpNgCenter.Shell/Assets/Fonts/Outfit-SemiBold.ttf#Outfit,avares://XcpNgCenter.Shell/Assets/Fonts/Outfit-Bold.ttf#Outfit</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- ShellThemeManager updates both Fluent accents alongside the shell palette. -->
        <ColorPaletteResources x:Key="Dark" Accent="#F07318" />
        <ColorPaletteResources x:Key="Light" Accent="#F07318" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style Selector="Button.alert-badge">
      <Setter Property="Background" Value="{DynamicResource Brush.BgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.alert-badge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.BgHover}" />
    </Style>
    <Style Selector="Button.alert-badge.has-alerts">
      <Setter Property="Background" Value="{DynamicResource Brush.BrandOrange}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    </Style>
    <Style Selector="Button.alert-badge.has-alerts:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.BrandOrangeDeep}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    </Style>
    <Style Selector="Border.alert-count">
      <Setter Property="Background" Value="{DynamicResource Brush.BgHover}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="28" />
    </Style>
    <Style Selector="Border.alert-count.has-alerts">
      <Setter Property="Background" Value="{DynamicResource Brush.BrandOrange}" />
    </Style>
    <Style Selector="Button.alert-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="Button.alert-badge.has-alerts TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    </Style>
    <Style Selector="Border.alert-count TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="Border.alert-count.has-alerts TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Font.Outfit}" />
      <Setter Property="Background" Value="{DynamicResource Brush.BgDeep}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Outfit}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Font.Outfit}" />
      <Setter Property="Background" Value="{DynamicResource Brush.BgElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeSubtle}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{DynamicResource Brush.BrandOrange}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.cta:pointerover /template/ ContentPresenter, Button.cta:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.BrandOrangeDeep}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.BgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.sidebar-action">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.copy">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Reserve 1px so hover border does not shift layout; chrome only on hover/focus. -->
    <Style Selector="Border.prop-row.copyable">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.prop-row.copyable:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandOrange}" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Border.prop-row.copyable:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandOrange}" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Border.prop-row.copyable:pointerover Button.copy">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style Selector="Border.prop-row.copyable:focus-within Button.copy">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style Selector="Button.copy:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style Selector="controls|PerformanceChart">
      <Setter Property="PlotColor" Value="{DynamicResource BgElevated}" />
      <Setter Property="GridColor" Value="{DynamicResource StrokeSubtle}" />
      <Setter Property="LabelColor" Value="{DynamicResource TextMuted}" />
      <Setter Property="TitleColor" Value="{DynamicResource TextPrimary}" />
      <Setter Property="AccentColor" Value="{DynamicResource AccentText}" />
      <Setter Property="TooltipColor" Value="{DynamicResource BgPanel}" />
    </Style>
  </Application.Styles>
</Application>
