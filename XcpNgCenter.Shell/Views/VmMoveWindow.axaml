<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        x:Class="XcpNgCenter.Shell.Views.VmMoveWindow"
        x:DataType="vm:VmMoveViewModel"
        Title="Move VM"
        Width="460" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="20" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <StackPanel Spacing="12">
      <TextBlock Text="Move VM" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Hint}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}" />
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}"
                 IsVisible="{Binding StatusMessage.Length}" />
      <ComboBox ItemsSource="{Binding StorageRepositories}"
                SelectedItem="{Binding SelectedStorage}"
                PlaceholderText="Destination SR">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MoveSrOption">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="cta" Content="Move" IsDefault="True" Command="{Binding MoveCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
