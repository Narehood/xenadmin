<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        x:Class="XcpNgCenter.Shell.Views.VmDeleteWindow"
        x:DataType="vm:VmDeleteViewModel"
        Title="Delete VM"
        Width="460" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="20" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <StackPanel Spacing="12">
      <TextBlock Text="Delete VM" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ConfirmText}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}"
                 IsVisible="{Binding StatusMessage.Length}" />
      <CheckBox Content="Delete virtual disks owned by this VM"
                IsChecked="{Binding DeleteDisks}" />
      <CheckBox Content="{Binding SnapshotsLabel}"
                IsChecked="{Binding DeleteSnapshots}"
                IsVisible="{Binding HasSnapshots}" />
      <TextBlock Text="The VM must be shut down. Snapshots and disks cannot be recovered after delete."
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="cta" Content="Delete" IsDefault="True" Command="{Binding DeleteCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
