<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        xmlns:svc="using:XcpNgCenter.Shell.Services"
        xmlns:controls="using:XcpNgCenter.Shell.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="XcpNgCenter.Shell.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="XCP-ng Center (Preview)"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        TransparencyLevelHint="None"
        Background="{StaticResource Brush.BgDeep}">

  <Window.Styles>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TreeViewItem" x:DataType="vm:InfraTreeNode" x:CompileBindings="True">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#SelectionBorder">
      <Setter Property="Background" Value="{StaticResource Brush.BgHover}" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#SelectionBorder">
      <Setter Property="Background" Value="#33273139" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#0E1216" />
        <GradientStop Offset="0.55" Color="#12181E" />
        <GradientStop Offset="1" Color="#1A140F" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid ColumnDefinitions="320,*">
      <Border Grid.Column="0"
              Background="#99161C22"
              BorderBrush="{StaticResource Brush.StrokeSubtle}"
              BorderThickness="0,0,1,0"
              Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="10" Margin="0,4,0,24">
            <Image Source="avares://XcpNgCenter.Shell/Assets/Images/xcp-ng-logo.png"
                   Width="44" Height="44"
                   HorizontalAlignment="Left" />
            <TextBlock Text="{Binding BrandName}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}" />
            <TextBlock Text="Preview shell"
                       FontSize="12"
                       Foreground="{StaticResource Brush.BrandOrange}" />
          </StackPanel>

          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <TextBlock Text="INFRASTRUCTURE"
                       FontSize="11"
                       LetterSpacing="1.2"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="4,0,0,8" />

            <TreeView Grid.Row="1"
                      IsVisible="{Binding ShowInfrastructure}"
                      ItemsSource="{Binding InfrastructureRoots}"
                      SelectedItem="{Binding SelectedInfraNode, Mode=TwoWay}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}"
                                  DataType="vm:InfraTreeNode">
                  <StackPanel Spacing="1" Margin="0,2">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Grid.Row="1"
                       IsVisible="{Binding ShowWelcome}"
                       Text="No servers yet"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="4,8,0,0" />
          </Grid>

          <TextBlock Grid.Row="2"
                     Text="WinForms XCP-ng Center remains the supported client."
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Opacity="0.85"
                     Margin="0,16,0,0" />
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid IsVisible="{Binding ShowWelcome}" Margin="56,48">
          <StackPanel VerticalAlignment="Center" Spacing="16" MaxWidth="560">
            <Image Source="avares://XcpNgCenter.Shell/Assets/Images/xcp-ng-logo.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Left"
                   Opacity="0.95">
              <Image.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                </Transitions>
              </Image.Transitions>
            </Image>

            <TextBlock Text="{Binding BrandName}"
                       FontSize="44"
                       FontWeight="Bold"
                       LineHeight="50"
                       Foreground="{StaticResource Brush.TextPrimary}" />

            <TextBlock Text="{Binding Tagline}"
                       FontSize="17"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextMuted}"
                       MaxWidth="480" />

            <StackPanel Spacing="10" Margin="0,8,0,0" MaxWidth="420">
              <TextBox Watermark="host.example or 10.0.0.5"
                       Text="{Binding HostInput}" />
              <TextBox Watermark="Username"
                       Text="{Binding Username}" />
              <TextBox Watermark="Password"
                       Text="{Binding Password}"
                       PasswordChar="•" />
              <CheckBox IsChecked="{Binding RememberPassword}"
                        IsEnabled="{Binding CanPersistPasswords}"
                        Content="{Binding RememberPasswordLabel}" />
              <Button Classes="cta"
                      Content="Connect"
                      HorizontalAlignment="Left"
                      Command="{Binding ConnectCommand}"
                      IsEnabled="{Binding !IsBusy}" />

              <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSavedServers}">
                <TextBlock Text="Saved servers"
                           FontSize="11"
                           LetterSpacing="1.1"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <ItemsControl ItemsSource="{Binding SavedServers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:SavedServerEntry">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <Button Classes="ghost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="10,8"
                                Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).UseSavedServerCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Address}"
                                       FontSize="13"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="Forget password"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasSavedPassword}"
                                Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).ForgetSavedPasswordCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PasswordVaultHint}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Opacity="0.9" />
              </StackPanel>

              <Button Classes="ghost"
                      HorizontalAlignment="Left"
                      Content="{Binding ClearPinsLabel}"
                      Command="{Binding ClearTrustedCertificatesCommand}"
                      IsVisible="{Binding HasTrustedCertificates}"
                      Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock IsVisible="{Binding ShowPublicIpWarning}"
                       Text="Public IP detected — prefer VPN, SSH tunnel, or a private path before exposing the management plane."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.BrandOrange}"
                       MaxWidth="520" />
            <CheckBox IsVisible="{Binding ShowPublicIpWarning}"
                      IsChecked="{Binding AcknowledgePublicIp}"
                      Content="I understand the risk — connect anyway" />

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextMuted}"
                       MaxWidth="520" />
          </StackPanel>

          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Width="280"
                  Margin="0,-48,-56,-48"
                  IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#00F07318" />
                <GradientStop Offset="0.45" Color="#33F07318" />
                <GradientStop Offset="1" Color="#14000000" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>

        <Grid IsVisible="{Binding ShowInfrastructure}" Margin="40,36" RowDefinitions="Auto,*,Auto">
          <DockPanel Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left" Spacing="6">
              <TextBlock Text="{Binding BrandName}"
                         FontSize="28"
                         FontWeight="Bold" />
              <TextBlock Text="Infrastructure"
                         Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button Classes="ghost"
                      Content="Disconnect"
                      Command="{Binding DisconnectSelectedCommand}" />
              <Button Classes="ghost"
                      Content="Remove"
                      Command="{Binding RemoveSelectedCommand}" />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1"
                  Background="#66161C22"
                  BorderBrush="{StaticResource Brush.StrokeSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="28">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="{Binding SelectedInfraNode.KindLabel, FallbackValue='Select an object'}"
                           FontSize="12"
                           LetterSpacing="1.1"
                           Foreground="{StaticResource Brush.BrandOrange}" />
                <TextBlock Text="{Binding SelectedInfraNode.Title, FallbackValue='Select a pool, host, or VM'}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedInfraNode.Subtitle, FallbackValue=''}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="15" />
              </StackPanel>

              <TabControl Grid.Row="1" Margin="0,12,0,0">
                <TabControl.Styles>
                  <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                  </Style>
                  <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                  </Style>
                  <!-- Keep tab content clear of the vertical scrollbar thumb. -->
                  <Style Selector="TabItem ScrollViewer">
                    <Setter Property="Padding" Value="0,0,20,0" />
                  </Style>
                </TabControl.Styles>

                <TabItem Header="General">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding GeneralProperties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row"
                                    Padding="0,2,0,10"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="160,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding PropertyCopyFeedback}"
                                 FontSize="12"
                                 Margin="0,4,0,0"
                                 Foreground="{StaticResource Brush.Ok}"
                                 IsVisible="{Binding PropertyCopyFeedback.Length}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Storage">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding StorageTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row"
                                    Padding="0,2,0,10"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="160,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Repositories"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasStorageItems}" />

                      <ItemsControl ItemsSource="{Binding StorageItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StorageItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="No storage objects for this selection."
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 FontSize="13"
                                 IsVisible="{Binding !HasStorageItems}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Network">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding NetworkTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row"
                                    Padding="0,2,0,10"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Networks"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasNetworkItems}" />

                      <ItemsControl ItemsSource="{Binding NetworkItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NetworkItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Management interfaces"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasNetworkMgmtItems}" />

                      <ItemsControl ItemsSource="{Binding NetworkMgmtItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NetworkItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="No network objects for this selection."
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 FontSize="13"
                                 IsVisible="{Binding !HasAnyNetworkContent}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Console">
                  <Grid Margin="0,18,0,0" RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="8" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding ConsoleTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Grid ColumnDefinitions="180,*" Margin="0,0,0,6">
                              <TextBlock Text="{Binding Label}"
                                         Foreground="{StaticResource Brush.TextMuted}"
                                         FontSize="13" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Value}"
                                         TextWrapping="Wrap"
                                         Foreground="{StaticResource Brush.TextPrimary}"
                                         FontSize="13" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="{Binding ConsoleStatusMessage}"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 Foreground="{StaticResource Brush.BrandOrange}" />
                      <TextBlock Text="{Binding ConsoleViewerStatus}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding ConsoleViewerStatus.Length}" />
                      <TextBlock Text="{Binding ConsoleInputHint}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.BrandOrange}"
                                 IsVisible="{Binding ConsoleInputHint.Length}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,4,0"
                            Background="#33161C22"
                            BorderBrush="{StaticResource Brush.StrokeSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            MinHeight="220">
                      <Grid>
                        <StackPanel Spacing="8"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    IsVisible="{Binding !HasConsoleFrame}">
                          <TextBlock Text="Console preview"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     Foreground="{StaticResource Brush.TextPrimary}" />
                          <TextBlock Text="{Binding ConsolePlaceholderMessage}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>

                        <controls:RfbConsoleView IsVisible="{Binding HasConsoleFrame}"
                                                 Frame="{Binding ConsoleBitmap}"
                                                 Session="{Binding ConsoleSession}"
                                                 ToolTip.Tip="Click to focus — keyboard and mouse are sent to the guest"
                                                 FocusCaptureChanged="OnConsoleFocusCaptureChanged" />
                      </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,12,0,0"
                                  MaxHeight="140"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasConsoleItems}">
                      <StackPanel Spacing="10" Margin="0,0,4,0">
                        <TextBlock Text="Console endpoints"
                                   FontSize="11"
                                   LetterSpacing="1.2"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <ItemsControl ItemsSource="{Binding ConsoleItems}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsoleItemRow">
                              <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,0,8,8"
                                      Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                  <TextBlock Text="{Binding Primary}"
                                             FontWeight="SemiBold"
                                             FontSize="13"
                                             Margin="0,0,12,0"
                                             Foreground="{StaticResource Brush.TextPrimary}" />
                                  <Button Grid.Column="1"
                                          Classes="ghost"
                                          Content="Copy"
                                          Padding="10,4"
                                          FontSize="12"
                                          IsVisible="{Binding CanCopyLocation}"
                                          Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyConsoleLocationCommand}"
                                          CommandParameter="{Binding Location}"
                                          ToolTip.Tip="Copy console location" />
                                  <TextBlock Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Text="{Binding Location}"
                                             FontSize="11"
                                             Foreground="{StaticResource Brush.TextMuted}"
                                             Margin="0,4,0,0"
                                             TextWrapping="Wrap"
                                             TextTrimming="CharacterEllipsis"
                                             IsVisible="{Binding CanCopyLocation}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ConsoleCopyFeedback}"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Ok}"
                                   IsVisible="{Binding ConsoleCopyFeedback.Length}" />
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Margin="0,16,0,0"
                     Text="{Binding StatusMessage}"
                     Foreground="{StaticResource Brush.TextMuted}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
