<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        xmlns:svc="using:XcpNgCenter.Shell.Services"
        xmlns:controls="using:XcpNgCenter.Shell.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="XcpNgCenter.Shell.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="XCP-ng Center (Preview)"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        TransparencyLevelHint="None"
        Background="{StaticResource Brush.BgDeep}">

  <Window.Styles>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TreeViewItem" x:DataType="vm:InfraTreeNode" x:CompileBindings="True">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#SelectionBorder">
      <Setter Property="Background" Value="{StaticResource Brush.BgHover}" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#SelectionBorder">
      <Setter Property="Background" Value="#33273139" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#0E1216" />
        <GradientStop Offset="0.55" Color="#12181E" />
        <GradientStop Offset="1" Color="#1A140F" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid ColumnDefinitions="320,*">
      <Border Grid.Column="0"
              Background="#99161C22"
              BorderBrush="{StaticResource Brush.StrokeSubtle}"
              BorderThickness="0,0,1,0"
              Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="8" Margin="0,4,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Image Source="avares://XcpNgCenter.Shell/Assets/Images/xcp-ng-logo.png"
                     Width="40" Height="40"
                     VerticalAlignment="Center" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding BrandName}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Preview shell"
                           FontSize="12"
                           Foreground="{StaticResource Brush.BrandOrange}" />
              </StackPanel>
              <Button Classes="alert-badge"
                      IsVisible="{Binding HasAlertsBadge}"
                      VerticalAlignment="Top"
                      Margin="0,2,0,0"
                      ToolTip.Tip="Open all alerts"
                      Command="{Binding OpenGlobalAlertsCommand}">
                <TextBlock Text="{Binding AlertsBadgeText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#141414" />
              </Button>
            </StackPanel>

            <UniformGrid Columns="2" Margin="0,8,0,0" IsVisible="{Binding ShowInfrastructure}">
              <Button Classes="ghost sidebar-action" Content="New VM"
                      HorizontalAlignment="Stretch" Margin="0,0,4,6"
                      Command="{Binding NewVmCommand}" />
              <Button Classes="ghost sidebar-action" Content="New SR"
                      HorizontalAlignment="Stretch" Margin="4,0,0,6"
                      Command="{Binding NewSrCommand}"
                      IsEnabled="{Binding ShowPoolStorageActions}" />
              <Button Classes="ghost sidebar-action" Content="Add Server"
                      HorizontalAlignment="Stretch" Margin="0,0,4,0"
                      Command="{Binding AddServerCommand}" />
              <Button Classes="ghost sidebar-action" Content="Import / Export"
                      HorizontalAlignment="Stretch" Margin="4,0,0,0"
                      Command="{Binding ImportExportVmCommand}"
                      IsEnabled="{Binding CanImportExportVm}" />
            </UniformGrid>
          </StackPanel>

          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <TextBlock Text="INFRASTRUCTURE"
                       FontSize="11"
                       LetterSpacing="1.2"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="4,0,0,8" />

            <TreeView Grid.Row="1"
                      x:Name="InfraTree"
                      IsVisible="{Binding ShowInfrastructure}"
                      ItemsSource="{Binding InfrastructureRoots}"
                      SelectedItem="{Binding SelectedInfraNode, Mode=TwoWay}"
                      PointerPressed="OnInfraTreePointerPressed">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="New VM…"
                            Command="{Binding NewVmCommand}"
                            IsVisible="{Binding ShowPoolContextActions}" />
                  <MenuItem Header="New SR…"
                            Command="{Binding NewSrCommand}"
                            IsVisible="{Binding ShowPoolContextActions}" />
                  <MenuItem Header="Refresh storage"
                            Command="{Binding RefreshStorageCommand}"
                            IsVisible="{Binding ShowPoolContextActions}" />
                  <Separator IsVisible="{Binding ShowPoolContextActions}" />
                  <MenuItem Header="Disconnect"
                            Command="{Binding DisconnectSelectedCommand}"
                            IsVisible="{Binding CanDisconnectSelected}" />
                  <MenuItem Header="Remove"
                            Command="{Binding RemoveSelectedCommand}"
                            IsVisible="{Binding CanDisconnectSelected}" />

                  <Separator IsVisible="{Binding ShowVmContextActions}" />
                  <MenuItem Header="Start" Command="{Binding StartVmCommand}" IsVisible="{Binding CanStartVm}" />
                  <MenuItem Header="Shutdown" Command="{Binding ShutdownVmCommand}" IsVisible="{Binding CanShutdownVm}" />
                  <MenuItem Header="Reboot" Command="{Binding RebootVmCommand}" IsVisible="{Binding CanRebootVm}" />
                  <MenuItem Header="Suspend" Command="{Binding SuspendVmCommand}" IsVisible="{Binding CanSuspendVm}" />
                  <MenuItem Header="Resume" Command="{Binding ResumeVmCommand}" IsVisible="{Binding CanResumeVm}" />
                  <MenuItem Header="Pause" Command="{Binding PauseVmCommand}" IsVisible="{Binding CanPauseVm}" />
                  <MenuItem Header="Unpause" Command="{Binding UnpauseVmCommand}" IsVisible="{Binding CanUnpauseVm}" />
                  <MenuItem Header="Force shutdown" Command="{Binding ForceShutdownVmCommand}" IsVisible="{Binding CanForceShutdownVm}" />
                  <MenuItem Header="Force reboot" Command="{Binding ForceRebootVmCommand}" IsVisible="{Binding CanForceRebootVm}" />
                  <Separator IsVisible="{Binding ShowVmContextActions}" />
                  <MenuItem Header="Properties" Command="{Binding EditVmCommand}" IsVisible="{Binding CanEditVm}" />
                  <MenuItem Header="Clone…" Command="{Binding CloneVmCommand}" IsVisible="{Binding CanCloneVm}" />
                  <MenuItem Header="Copy…" Command="{Binding CopyVmCommand}" IsVisible="{Binding CanCopyVm}" />
                  <MenuItem Header="Export…" Command="{Binding ExportVmCommand}" IsVisible="{Binding CanExportVm}" />
                  <MenuItem Header="Migrate…" Command="{Binding MigrateVmCommand}" IsVisible="{Binding CanMigrateVm}" />
                  <MenuItem Header="Cross-pool…" Command="{Binding CrossPoolMigrateVmCommand}" IsVisible="{Binding CanCrossPoolMigrateVm}" />
                  <MenuItem Header="Move…" Command="{Binding MoveVmCommand}" IsVisible="{Binding CanMoveVm}" />
                  <MenuItem Header="Delete…" Command="{Binding DeleteVmCommand}" IsVisible="{Binding CanDeleteVm}" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}"
                                  DataType="vm:InfraTreeNode">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0">
                    <Image Width="14" Height="14"
                           VerticalAlignment="Center"
                           Source="{Binding StatusIcon}"
                           IsVisible="{Binding ShowStatusIcon}"
                           ToolTip.Tip="{Binding StatusTooltip}" />
                    <StackPanel Spacing="0">
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="SemiBold"
                                 FontSize="12"
                                 LineHeight="16"
                                 Foreground="{StaticResource Brush.TextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}"
                                 FontSize="10"
                                 LineHeight="13"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Grid.Row="1"
                       IsVisible="{Binding ShowWelcome}"
                       Text="No servers yet"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="4,8,0,0" />
          </Grid>

          <TextBlock Grid.Row="2"
                     Text="WinForms XCP-ng Center remains the supported client."
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Opacity="0.85"
                     Margin="0,16,0,0" />
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid IsVisible="{Binding ShowWelcome}" Margin="48,40,0,40">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Padding="8,8,20,8">
            <StackPanel VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="380"
                        HorizontalAlignment="Left"
                        Margin="8,0,0,0">
              <Image Source="avares://XcpNgCenter.Shell/Assets/Images/xcp-ng-logo.png"
                     Width="72" Height="72"
                     HorizontalAlignment="Left"
                     Opacity="0.95">
                <Image.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                  </Transitions>
                </Image.Transitions>
              </Image>

              <TextBlock Text="{Binding BrandName}"
                         FontSize="40"
                         FontWeight="Bold"
                         LineHeight="46"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding Tagline}"
                         FontSize="16"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Brush.TextMuted}" />

              <StackPanel Spacing="10" Margin="0,8,0,0" Width="360" MaxWidth="360" HorizontalAlignment="Left">
                <TextBox Watermark="host.example or 10.0.0.5"
                         Text="{Binding HostInput}" />
                <TextBox Watermark="Username"
                         Text="{Binding Username}" />
                <TextBox Watermark="Password"
                         Text="{Binding Password}"
                         PasswordChar="•" />
                <CheckBox IsChecked="{Binding RememberPassword}"
                          IsEnabled="{Binding CanPersistPasswords}"
                          Content="{Binding RememberPasswordLabel}" />
                <Button Classes="cta"
                        Content="Connect"
                        HorizontalAlignment="Left"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding !IsBusy}" />

                <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSavedServers}">
                  <TextBlock Text="Saved servers"
                             FontSize="11"
                             LetterSpacing="1.1"
                             Foreground="{StaticResource Brush.TextMuted}" />
                  <ItemsControl ItemsSource="{Binding SavedServers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:SavedServerEntry">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                          <Button Classes="ghost"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Padding="10,8"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).UseSavedServerCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Address}"
                                         FontSize="13"
                                         Foreground="{StaticResource Brush.TextPrimary}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}"
                                         FontSize="11"
                                         Foreground="{StaticResource Brush.TextMuted}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="1"
                                  Classes="ghost"
                                  Content="Forget"
                                  FontSize="11"
                                  Padding="8,4"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasSavedPassword}"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).ForgetSavedPasswordCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding PasswordVaultHint}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Brush.TextMuted}"
                             Opacity="0.9" />
                </StackPanel>

                <Button Classes="ghost"
                        HorizontalAlignment="Left"
                        Content="{Binding ClearPinsLabel}"
                        Command="{Binding ClearTrustedCertificatesCommand}"
                        IsVisible="{Binding HasTrustedCertificates}"
                        Margin="0,4,0,0" />
              </StackPanel>

              <TextBlock IsVisible="{Binding ShowPublicIpWarning}"
                         Text="Public IP detected — prefer VPN, SSH tunnel, or a private path before exposing the management plane."
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Brush.BrandOrange}"
                         MaxWidth="360" />
              <CheckBox IsVisible="{Binding ShowPublicIpWarning}"
                        IsChecked="{Binding AcknowledgePublicIp}"
                        Content="I understand the risk — connect anyway"
                        MaxWidth="360" />

              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Brush.TextMuted}"
                         MaxWidth="360" />
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="0,-40,0,-40"
                  IsHitTestVisible="False"
                  ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#00F07318" />
                <GradientStop Offset="0.45" Color="#33F07318" />
                <GradientStop Offset="1" Color="#14000000" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>


        <Grid IsVisible="{Binding ShowGlobalAlerts}" Margin="28,24,28,16" RowDefinitions="Auto,*">
          <StackPanel Spacing="8" Margin="0,0,0,12">
            <DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Alerts"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Background="{StaticResource Brush.BrandOrange}"
                        CornerRadius="10"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasAlertsBadge}">
                  <TextBlock Text="{Binding AlertsBadgeText}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#141414" />
                </Border>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          Spacing="8"
                          HorizontalAlignment="Right">
                <Button Classes="ghost"
                        Content="Dismiss selected"
                        Command="{Binding DismissSelectedAlertsCommand}" />
                <Button Classes="ghost"
                        Content="Dismiss all"
                        Command="{Binding DismissAllAlertsCommand}" />
                <Button Classes="ghost"
                        Content="Back"
                        Command="{Binding CloseGlobalAlertsCommand}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="All messages from every connected pool and server, newest first."
                       FontSize="13"
                       Foreground="{StaticResource Brush.TextMuted}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,4,0">
              <TextBlock Text="No alerts. Messages from all connected pools appear here."
                         Foreground="{StaticResource Brush.TextMuted}"
                         IsVisible="{Binding !HasAlertItems}" />
              <ItemsControl ItemsSource="{Binding AlertItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlertItemRow">
                    <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,2,10,0"
                                  IsEnabled="{Binding CanDismiss}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <DockPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding PriorityLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.BrandOrange}"
                                       Margin="12,0,0,0" />
                          </DockPanel>
                          <TextBlock Text="{Binding Description}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource Brush.TextMuted}" />
                          <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="12,0,0,0">
                              <Button Classes="ghost"
                                      Content="{Binding FixLinkText}"
                                      FontSize="11"
                                      Padding="8,2"
                                      IsVisible="{Binding HasFixLink}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RunAlertFixCommand}"
                                      CommandParameter="{Binding}" />
                              <TextBlock Text="{Binding TimestampText}"
                                         FontSize="11"
                                         Foreground="{StaticResource Brush.TextMuted}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid IsVisible="{Binding ShowInfrastructureDetail}" Margin="28,24,28,16" RowDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Padding="12,0,12,0">
            <StackPanel Spacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedInfraNode.KindLabel, FallbackValue='Select an object'}"
                           FontSize="12"
                           LetterSpacing="1.1"
                           Foreground="{StaticResource Brush.BrandOrange}" />
                <TextBlock Text="{Binding SelectedInfraNode.Title, FallbackValue='Select a pool, host, or VM'}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedInfraNode.Subtitle, FallbackValue=''}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="15" />
                <TextBlock Text="{Binding ActionStatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}"
                           IsVisible="{Binding ActionStatusMessage.Length}" />
                <TextBlock Text="Right-click a pool, host, or VM in the tree for actions."
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Opacity="0.85"
                           IsVisible="{Binding !ShowVmActionBar}" />
              </StackPanel>

              <WrapPanel Orientation="Horizontal"
                         IsVisible="{Binding ShowVmActionBar}">
                <Button Classes="ghost" Content="Start" Margin="0,0,8,6" Command="{Binding StartVmCommand}" />
                <Button Classes="ghost" Content="Shutdown" Margin="0,0,8,6" Command="{Binding ShutdownVmCommand}" />
                <Button Classes="ghost" Content="Reboot" Margin="0,0,8,6" Command="{Binding RebootVmCommand}" />
                <Button Classes="ghost" Content="{Binding SuspendToggleLabel}" Margin="0,0,8,6"
                        Command="{Binding ToggleSuspendVmCommand}"
                        IsVisible="{Binding ShowSuspendToggle}" />
                <Button Classes="ghost" Content="{Binding PauseToggleLabel}" Margin="0,0,8,6"
                        Command="{Binding TogglePauseVmCommand}"
                        IsVisible="{Binding ShowPauseToggle}" />
              </WrapPanel>

              <TabControl Margin="0,4,0,0">
                <TabControl.Styles>
                  <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                  </Style>
                  <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                  </Style>
                  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="Background" Value="{StaticResource Brush.BrandOrange}" />
                    <Setter Property="Height" Value="3" />
                  </Style>
                  <!-- Keep tab content clear of the vertical scrollbar thumb. -->
                  <Style Selector="TabItem ScrollViewer">
                    <Setter Property="Padding" Value="0,0,20,0" />
                  </Style>
                </TabControl.Styles>

                <TabItem Header="General">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,4,0">
                      <Button Classes="ghost"
                              Content="Properties"
                              HorizontalAlignment="Left"
                              Command="{Binding EditVmCommand}"
                              IsVisible="{Binding CanEditVm}" />
                      <ItemsControl ItemsSource="{Binding GeneralProperties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row prop-row-dense"
                                    Classes.copyable="{Binding CanCopy}"
                                    Padding="6,2"
                                    Margin="0,0,0,1"
                                    CornerRadius="4"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="160,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding PropertyCopyFeedback}"
                                 FontSize="12"
                                 Margin="0,4,0,0"
                                 Foreground="{StaticResource Brush.Ok}"
                                 IsVisible="{Binding PropertyCopyFeedback.Length}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Storage">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding StorageTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row"
                                    Classes.copyable="{Binding CanCopy}"
                                    Padding="8,6"
                                    Margin="0,0,0,4"
                                    CornerRadius="6"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="160,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Repositories"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasStorageItems}" />

                      <ItemsControl ItemsSource="{Binding StorageItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StorageItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="No storage objects for this selection."
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 FontSize="13"
                                 IsVisible="{Binding !HasStorageItems}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Network">
                  <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding NetworkTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Border Classes="prop-row"
                                    Classes.copyable="{Binding CanCopy}"
                                    Padding="8,6"
                                    Margin="0,0,0,4"
                                    CornerRadius="6"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="180,*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           Margin="0,2,8,0" />
                                <Button Grid.Column="2"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopy}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyPropertyValueCommand}"
                                        CommandParameter="{Binding Value}"
                                        ToolTip.Tip="Copy value" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Networks"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasNetworkItems}" />

                      <ItemsControl ItemsSource="{Binding NetworkItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NetworkItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Management interfaces"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding HasNetworkMgmtItems}" />

                      <ItemsControl ItemsSource="{Binding NetworkMgmtItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NetworkItemRow">
                            <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,8,12"
                                    Margin="0,0,0,12">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Secondary}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,12,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Meta}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,4,0,0"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.BrandOrange}"
                                           Margin="0,4,0,0"
                                           Opacity="0.9" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="No network objects for this selection."
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 FontSize="13"
                                 IsVisible="{Binding !HasAnyNetworkContent}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Console">
                  <StackPanel Margin="0,18,0,8" Spacing="10">
                    <StackPanel Spacing="6" IsVisible="{Binding ShowConsoleIsoBar}">
                      <TextBlock Text="CD/DVD"
                                 FontSize="11"
                                 LetterSpacing="1.1"
                                 Foreground="{StaticResource Brush.TextMuted}" />
                      <TextBlock Text="{Binding AttachedIsoLabel}"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}" />
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <ComboBox ItemsSource="{Binding ConsoleIsoOptions}"
                                  SelectedItem="{Binding SelectedConsoleIso}"
                                  PlaceholderText="Select ISO…"
                                  IsEnabled="{Binding HasConsoleIsoOptions}"
                                  MinHeight="36">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:IsoOption">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Classes="ghost" Content="Insert"
                                Margin="8,0,0,0"
                                Command="{Binding ApplyConsoleIsoCommand}"
                                ToolTip.Tip="Insert the selected ISO" />
                        <Button Grid.Column="2" Classes="ghost" Content="Eject"
                                Margin="8,0,0,0"
                                Command="{Binding EjectIsoCommand}"
                                ToolTip.Tip="Eject the current ISO" />
                        <Button Grid.Column="3" Classes="ghost" Content="Browse…"
                                Margin="8,0,0,0"
                                Command="{Binding AttachIsoCommand}"
                                ToolTip.Tip="Open the full ISO library picker" />
                      </Grid>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal"
                               IsVisible="{Binding HasConsoleFrame}">
                      <Button Classes="ghost" Content="Pop Out" Margin="0,0,8,6"
                              Command="{Binding PopOutConsoleCommand}"
                              IsVisible="{Binding !IsConsolePoppedOut}" />
                      <Button Classes="ghost" Content="Reattach" Margin="0,0,8,6"
                              Command="{Binding ReattachConsoleCommand}"
                              IsVisible="{Binding ShowConsoleReattach}" />
                      <Button Classes="ghost" Content="Ctrl+Alt+Del" Margin="0,0,8,6"
                              Command="{Binding SendCtrlAltDelCommand}" />
                    </WrapPanel>

                    <Border Background="#33161C22"
                            BorderBrush="{StaticResource Brush.StrokeSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Height="560"
                            MinHeight="560"
                            ClipToBounds="True">
                      <Grid ClipToBounds="True">
                        <StackPanel Spacing="8"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    IsVisible="{Binding !HasConsoleFrame}">
                          <TextBlock Text="Console preview"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     Foreground="{StaticResource Brush.TextPrimary}" />
                          <TextBlock Text="{Binding ConsolePlaceholderMessage}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>

                        <StackPanel Spacing="8"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    IsVisible="{Binding ShowConsoleReattach}">
                          <TextBlock Text="Console is in a separate window"
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     HorizontalAlignment="Center" />
                          <Button Classes="cta" Content="Reattach here" HorizontalAlignment="Center"
                                  Command="{Binding ReattachConsoleCommand}" />
                        </StackPanel>

                        <controls:RfbConsoleView IsVisible="{Binding ShowEmbeddedConsole}"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 ClipToBounds="True"
                                                 Frame="{Binding ConsoleBitmap}"
                                                 Session="{Binding ConsoleSession}"
                                                 ToolTip.Tip="Click the console to capture keyboard, mouse, and scroll — until then the page keeps scrolling"
                                                 FocusCaptureChanged="OnConsoleFocusCaptureChanged" />
                      </Grid>
                    </Border>

                    <StackPanel Spacing="6" Margin="0,4,4,0">
                      <ItemsControl ItemsSource="{Binding ConsoleTotals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GeneralPropertyRow">
                            <Grid ColumnDefinitions="120,*" Margin="0,0,0,2">
                              <TextBlock Text="{Binding Label}"
                                         Foreground="{StaticResource Brush.TextMuted}"
                                         FontSize="12" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Value}"
                                         TextWrapping="Wrap"
                                         Foreground="{StaticResource Brush.TextPrimary}"
                                         FontSize="12" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="{Binding ConsoleStatusMessage}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.BrandOrange}"
                                 IsVisible="{Binding ConsoleStatusMessage.Length}" />
                      <TextBlock Text="{Binding ConsoleViewerStatus}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding ConsoleViewerStatus.Length}" />
                      <TextBlock Text="{Binding ConsoleInputHint}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.BrandOrange}"
                                 IsVisible="{Binding ConsoleInputHint.Length}" />
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="0,0,4,0"
                                IsVisible="{Binding HasConsoleItems}">
                      <TextBlock Text="Console endpoints"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}" />
                      <ItemsControl ItemsSource="{Binding ConsoleItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConsoleItemRow">
                            <Border Classes="prop-row"
                                    Classes.copyable="{Binding CanCopyLocation}"
                                    Padding="8,6"
                                    Margin="0,0,0,4"
                                    CornerRadius="6"
                                    Background="Transparent">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,12,0"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <Button Grid.Column="1"
                                        Classes="copy"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding CanCopyLocation}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyConsoleLocationCommand}"
                                        CommandParameter="{Binding Location}"
                                        ToolTip.Tip="Copy console location" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Location}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding CanCopyLocation}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding ConsoleCopyFeedback}"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.Ok}"
                                 IsVisible="{Binding ConsoleCopyFeedback.Length}" />
                    </StackPanel>
                  </StackPanel>
                </TabItem>

                <TabItem Header="Snapshots">
                  <Panel Margin="0,18,0,8">
                    <StackPanel Spacing="14" IsVisible="{Binding CanManageSnapshots}">
                      <TextBlock Text="Disk snapshots form a tree from the VM base. NOW marks the current branch tip. Memory checkpoints come later."
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}" />
                      <TextBox Watermark="Snapshot name" Text="{Binding NewSnapshotName}" />
                      <TextBox Watermark="Description (optional)" Text="{Binding NewSnapshotDescription}" />
                      <Button Classes="cta"
                              Content="Take snapshot"
                              HorizontalAlignment="Left"
                              Command="{Binding TakeSnapshotCommand}" />
                      <TextBlock Text="{Binding SnapshotStatusMessage}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 IsVisible="{Binding SnapshotStatusMessage.Length}" />

                      <TextBlock Text="Snapshot tree"
                                 FontSize="11"
                                 LetterSpacing="1.2"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 Margin="0,8,0,0" />
                      <TreeView ItemsSource="{Binding SnapshotItems}"
                                MinHeight="160">
                        <TreeView.Styles>
                          <Style Selector="TreeViewItem" x:DataType="vm:SnapshotItemRow" x:CompileBindings="True">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="Padding" Value="4,3" />
                          </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                          <TreeDataTemplate ItemsSource="{Binding Children}"
                                            DataType="vm:SnapshotItemRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="280">
                              <Image Width="16" Height="16"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Source="{Binding Icon}" />
                              <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Description.Length}" />
                                <TextBlock Text="{Binding Created}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           IsVisible="{Binding Created.Length}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          VerticalAlignment="Center">
                                <Button Classes="ghost"
                                        Content="Revert"
                                        FontSize="12"
                                        Padding="10,4"
                                        IsVisible="{Binding CanRevert}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RevertSnapshotCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="ghost"
                                        Content="Delete"
                                        FontSize="12"
                                        Padding="10,4"
                                        IsVisible="{Binding CanDelete}"
                                        Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).DeleteSnapshotCommand}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                            </Grid>
                          </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                      </TreeView>
                    </StackPanel>
                    <TextBlock Text="Select a VM to manage snapshots."
                               IsVisible="{Binding !CanManageSnapshots}"
                               Foreground="{StaticResource Brush.TextMuted}" />
                  </Panel>
                </TabItem>

                <TabItem Header="Performance">
                  <Grid Margin="0,18,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8" Margin="0,0,4,8">
                      <DockPanel>
                        <TextBlock Text="Performance"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                          <ComboBox Width="180"
                                    ItemsSource="{Binding PerformanceRangeOptions}"
                                    SelectedItem="{Binding SelectedPerformanceRange}"
                                    IsEnabled="{Binding CanShowPerformance}" />
                          <Button Classes="ghost"
                                  Content="Save layout"
                                  Command="{Binding SavePerformanceLayoutCommand}"
                                  IsEnabled="{Binding CanSavePerformanceLayout}" />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Text="{Binding PerformanceStatusMessage}"
                                 FontSize="12"
                                 Foreground="{StaticResource Brush.TextMuted}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="16" Margin="0,0,4,0">
                        <TextBlock Text="Select a host or running VM to load RRD graphs."
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   IsVisible="{Binding !CanShowPerformance}" />
                        <TextBlock Text="Waiting for graph series…"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   IsVisible="{Binding ShowPerformanceWaiting}" />
                        <ItemsControl ItemsSource="{Binding PerformanceGraphs}"
                                      IsVisible="{Binding HasPerformanceGraphs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PerformanceGraphRow">
                              <StackPanel Spacing="6" Margin="0,0,0,8">
                                <DockPanel>
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold"
                                             FontSize="13" />
                                  <TextBlock DockPanel.Dock="Right"
                                             Text="{Binding LatestSummary}"
                                             FontSize="11"
                                             Foreground="{StaticResource Brush.TextMuted}"
                                             TextTrimming="CharacterEllipsis"
                                             Margin="12,0,0,0"
                                             MaxWidth="420"
                                             HorizontalAlignment="Right" />
                                </DockPanel>
                                <controls:PerformanceChart Height="180"
                                                           Series="{Binding Series}"
                                                           Interval="{Binding Interval}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </TabItem>

                <TabItem Header="Logs">
                  <Grid Margin="0,18,0,0" RowDefinitions="Auto,*">
                    <DockPanel Margin="0,0,4,8">
                      <TextBlock Text="Tasks and actions"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <Button DockPanel.Dock="Right"
                              Classes="ghost"
                              Content="Dismiss completed"
                              Command="{Binding DismissCompletedActionsCommand}"
                              HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="8" Margin="0,0,4,0">
                        <TextBlock Text="No actions yet. Power, create, and storage operations appear here."
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   IsVisible="{Binding !HasActionLogRows}" />
                        <ItemsControl ItemsSource="{Binding ActionLogRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionLogRow">
                              <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,0,0,10"
                                      Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold"
                                             FontSize="13"
                                             TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Status}"
                                             FontSize="12"
                                             Foreground="{StaticResource Brush.BrandOrange}"
                                             Margin="12,0,0,0" />
                                  <TextBlock Grid.Row="1"
                                             Text="{Binding Description}"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             Foreground="{StaticResource Brush.TextMuted}"
                                             Margin="0,4,0,0" />
                                  <TextBlock Grid.Row="2"
                                             Text="{Binding StartedText}"
                                             FontSize="11"
                                             Foreground="{StaticResource Brush.TextMuted}"
                                             Margin="0,4,0,0" />
                                  <StackPanel Grid.Row="2"
                                              Grid.Column="1"
                                              Orientation="Horizontal"
                                              Spacing="6"
                                              HorizontalAlignment="Right">
                                    <Button Classes="ghost"
                                            Content="Cancel"
                                            FontSize="11"
                                            Padding="8,2"
                                            IsVisible="{Binding CanCancel}"
                                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CancelActionCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="ghost"
                                            Content="Dismiss"
                                            FontSize="11"
                                            Padding="8,2"
                                            IsVisible="{Binding IsCompleted}"
                                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).DismissActionCommand}"
                                            CommandParameter="{Binding}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </TabItem>
              </TabControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="1"
                     Margin="0,12,0,0"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
