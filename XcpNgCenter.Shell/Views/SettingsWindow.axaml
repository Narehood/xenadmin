<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        x:Class="XcpNgCenter.Shell.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="560"
        Height="560"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">

  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <TextBlock Text="Settings"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,16" />

    <TabControl Grid.Row="1">
      <TabItem Header="General">
        <StackPanel Spacing="14" Margin="0,16,0,0">
          <CheckBox Content="Reconnect saved servers on startup"
                    IsChecked="{Binding AutoReconnectSavedServers}" />
          <TextBlock Text="When enabled, the shell signs into every saved server that has a stored password."
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />

          <CheckBox Content="Automatically retry lost connections"
                    IsChecked="{Binding AutoRetryLostConnections}"
                    Margin="0,8,0,0" />
          <TextBlock Text="When disabled (default), a server that drops offline stays in the list as disconnected until you reconnect. A failed first-time add never auto-retries."
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />

          <TextBlock Text="Main password"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="0,12,0,0" />
          <CheckBox Content="Require a main password"
                    IsChecked="{Binding RequireMainPassword, Mode=OneWay}"
                    Command="{Binding ToggleRequireMainPasswordCommand}" />
          <TextBlock Text="{Binding MainPasswordStatus}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />
          <Button Classes="ghost"
                  Content="Change main password…"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding CanChangeMainPassword}"
                  Command="{Binding ChangeMainPasswordCommand}" />

          <TextBlock Text="{Binding PasswordStorageNote}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Margin="0,8,0,0" />

          <Button Classes="ghost"
                  Content="Clear trusted certificates"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Command="{Binding ClearTrustedCertificatesCommand}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Privacy">
        <StackPanel Spacing="12" Margin="0,16,0,0">
          <TextBlock Text="Hide in-app identifiers"
                     FontSize="14"
                     FontWeight="SemiBold" />
          <TextBlock Text="Useful for screenshots and demos. Raw values stay available for connections; only displayed text is masked."
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />
          <CheckBox Content="Hide IP addresses / hostnames"
                    IsChecked="{Binding HideIpAddresses}" />
          <CheckBox Content="Hide UUIDs"
                    IsChecked="{Binding HideUuids}" />
          <CheckBox Content="Hide VM names"
                    IsChecked="{Binding HideVmNames}" />
          <CheckBox Content="Hide server names"
                    IsChecked="{Binding HideServerNames}" />
          <CheckBox Content="Hide cluster names"
                    IsChecked="{Binding HideClusterNames}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="About">
        <StackPanel Spacing="10" Margin="0,16,0,0">
          <TextBlock Text="XCP-ng Center (Preview)"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="Version"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="13" />
            <TextBlock Grid.Column="1"
                       Text="{Binding VersionText}"
                       FontSize="13" />
            <TextBlock Grid.Row="1"
                       Text="Build date"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="13"
                       Margin="0,6,0,0" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding BuildDateText}"
                       FontSize="13"
                       Margin="0,6,0,0" />
            <TextBlock Grid.Row="2"
                       Text="Codename"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="13"
                       Margin="0,6,0,0" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding CodenameText}"
                       FontSize="13"
                       Margin="0,6,0,0" />
          </Grid>

          <Button Classes="cta"
                  Content="Check for updates"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Command="{Binding CheckForUpdatesCommand}" />
          <TextBlock Text="{Binding UpdateCheckStatus}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}"
                     IsVisible="{Binding HasUpdateCheckStatus}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2"
            Classes="ghost"
            Content="Close"
            HorizontalAlignment="Right"
            Margin="0,16,0,0"
            IsCancel="True"
            Command="{Binding CloseCommand}" />
  </Grid>
</Window>
