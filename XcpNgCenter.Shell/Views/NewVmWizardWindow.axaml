<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XcpNgCenter.Shell.Views"
        xmlns:xena="clr-namespace:XenAPI;assembly=XenModel"
        x:Class="XcpNgCenter.Shell.Views.NewVmWizardWindow"
        x:DataType="views:NewVmWizardViewModel"
        Title="New VM"
        Width="700" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.BgDeep}">
  <Border Margin="16" Padding="20"
          Background="{DynamicResource Brush.BgPanel}"
          BorderBrush="{DynamicResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="New VM" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StepTitle}" Foreground="{DynamicResource Brush.AccentText}" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   IsVisible="{Binding StatusMessage.Length}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="0,16,0,16" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <StackPanel IsVisible="{Binding ShowTemplateStep}" Spacing="8">
          <TextBlock Text="Select a template" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox PlaceholderText="Filter templates…" Text="{Binding TemplateFilter}" />
          <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MaxHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="views:TemplateOption">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                  <Image Width="16" Height="16"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         Source="{Binding Icon}" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="28" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{Binding TypeLabel}"
                             FontSize="11"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.AccentText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowNameStep}" Spacing="10">
          <TextBlock Text="VM name" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox PlaceholderText="VM name" Text="{Binding VmName}" />
          <TextBlock Text="Description" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox PlaceholderText="Description" Text="{Binding VmDescription}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
          <TextBlock Text="Home / placement host" Foreground="{DynamicResource Brush.TextMuted}" />
          <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" PlaceholderText="Select a placement host">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="xena:Host">
                <TextBlock Text="{Binding name_label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Storage choices will be limited to repositories visible from this host."
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextMuted}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowInstallationStep}" Spacing="10">
          <TextBlock Text="ISO image / physical DVD drive" Foreground="{DynamicResource Brush.TextMuted}" />
          <ComboBox x:Name="InstallationMediaPicker" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding InstallationMedia}" SelectedItem="{Binding SelectedMedia}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:NewVmMediaOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Only media available to the placement host is listed. Add an ISO storage repository to the pool to make more images available."
                     TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
          <StackPanel IsVisible="{Binding IsHvmTemplate}" Spacing="10">
          <TextBlock Text="Boot firmware" Foreground="{DynamicResource Brush.TextMuted}" />
          <ComboBox x:Name="BootModePicker" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding BootModes}" SelectedItem="{Binding SelectedBootMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:NewVmBootOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Firmware choices depend on the template and pool. Secure Boot requires guest UEFI certificates on the host; verify enforcement after the first boot."
                     TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
          <CheckBox x:Name="VtpmCheckBox" Content="Enable virtual TPM 2.0" IsChecked="{Binding EnableVtpm}"
                    IsEnabled="{Binding CanEditVtpm}" />
          <TextBlock Text="{Binding VtpmHelpText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowComputeStep}" Spacing="8">
          <TextBlock Text="vCPUs at startup" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox x:Name="StartupCpusText" Text="{Binding VcpusText}" />
          <TextBlock Text="Maximum vCPUs" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox x:Name="MaximumCpusText" Text="{Binding VcpusMaxText}" />
          <TextBlock Text="Cores per socket" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox x:Name="CoresPerSocketText" Text="{Binding CoresPerSocketText}" />
          <TextBlock Text="{Binding CpuTopologyText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
          <TextBlock Text="Memory (MiB)" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox PlaceholderText="Memory (MiB)" Text="{Binding MemoryMibText}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowStorageStep}" Spacing="10">
          <Border Padding="12,9"
                  Background="{DynamicResource Brush.BgElevated}"
                  BorderBrush="{DynamicResource Brush.StrokeSubtle}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Placement host" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Grid.Column="1"
                         Margin="16,0,0,0"
                         Text="{Binding PlacementHostText}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <TextBlock Text="Storage repository" Foreground="{DynamicResource Brush.TextMuted}" />
          <ComboBox ItemsSource="{Binding StorageRepositories}"
                    SelectedItem="{Binding SelectedStorage}"
                    PlaceholderText="Select a compatible storage repository">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:NewVmStorageOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding StoragePlacementText}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.AccentText}" />
          <TextBlock Text="Disk size" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBox PlaceholderText="Disk size (GiB)" Text="{Binding DiskGibText}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowNetworkStep}" Spacing="10">
          <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="xena:Network">
                <TextBlock Text="{Binding name_label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Start VM after create" IsChecked="{Binding StartAfter}" />
        </StackPanel>

        <TextBlock IsVisible="{Binding ShowConfirmStep}"
                   Text="{Binding SummaryText}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="22" />
      </Panel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="ghost" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
        <Button Classes="cta"
                Content="Create"
                Command="{Binding NextCommand}"
                IsVisible="{Binding IsLastStep}" />
        <Button Classes="cta"
                Content="Next"
                Command="{Binding NextCommand}"
                IsVisible="{Binding !IsLastStep}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
