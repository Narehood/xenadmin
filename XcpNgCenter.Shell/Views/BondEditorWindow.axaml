<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels" xmlns:services="using:XcpNgCenter.Shell.Services"
        x:Class="XcpNgCenter.Shell.Views.BondEditorWindow" x:DataType="vm:BondEditorViewModel"
        Title="{Binding Title}" Width="680" Height="700" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgDeep}">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="8" Margin="0,0,0,18">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Bonds apply to the same NICs on every host in the pool. Management, IP-configured, cluster, VLAN, tunnel, SR-IOV and VM-connected interfaces must be left in place."
                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,8,0" IsEnabled="{Binding !IsSaving}">
        <TextBlock Text="Bond network" /><TextBox Text="{Binding NameLabel}" IsReadOnly="{Binding !IsCreating}" />
        <StackPanel Spacing="10" IsVisible="{Binding IsCreating}">
          <TextBlock Text="Physical NICs (select 2–4; bridge hosts allow 2)" />
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BondMemberOption">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" />
                  <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="28,0,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="MTU (bytes)" /><TextBox Text="{Binding Mtu}" />
          <CheckBox Content="Automatically add this network to new VMs" IsChecked="{Binding Automatic}" />
        </StackPanel>
        <TextBlock Text="{Binding MembersSummary}" IsVisible="{Binding !IsCreating}" />
        <TextBlock Text="{Binding CurrentModeNotice}" IsVisible="{Binding !IsCreating}"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Text="Bond mode" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="services:BondModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Configure matching LACP groups on the physical switches before applying this mode. LACP requires vSwitch on every host."
                   IsVisible="{Binding IsLacp}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
        <TextBlock Text="Use unused interfaces only. Move or remove VM interfaces and dependent networks before changing an existing bond."
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Brush.AccentText}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
      <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" IsEnabled="{Binding !IsSaving}" />
      <Button Classes="cta" Content="Apply" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
    </StackPanel>
  </Grid>
</Window>
