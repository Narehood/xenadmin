<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        x:Class="XcpNgCenter.Shell.Views.VifEditorWindow" x:DataType="vm:VifEditorViewModel"
        Title="{Binding Title}" Width="600" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.BgDeep}">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" Background="{StaticResource Brush.BgDeep}">
    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,8,0" IsEnabled="{Binding !IsSaving}">
        <TextBlock Text="Network / VLAN" />
        <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VmNetworkOption"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="MAC address (leave blank to generate)" />
        <TextBox Text="{Binding Mac}" Watermark="02:00:00:00:00:01" />
        <StackPanel Spacing="8" IsEnabled="{Binding CanEditRate}">
          <CheckBox Content="Limit bandwidth" IsChecked="{Binding Limit}" />
          <StackPanel Spacing="8" IsVisible="{Binding Limit}">
            <TextBlock Text="Maximum rate (KB/s)" /><TextBox Text="{Binding Rate}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" />
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Brush.BrandOrange}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
      <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" IsEnabled="{Binding !IsSaving}" />
      <Button Classes="cta" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaving}" />
    </StackPanel>
  </Grid>
</Window>
