<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        xmlns:xena="clr-namespace:XenAPI;assembly=XenModel"
        x:Class="XcpNgCenter.Shell.Views.OvfImportWindow"
        x:DataType="vm:OvfImportViewModel"
        Title="Import OVF / OVA"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="16" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,8,0">
          <TextBlock Text="Import OVF / OVA" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Hint}" TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}"
                     IsVisible="{Binding StatusMessage.Length}" />

          <TextBlock Text="Appliance file" Foreground="{StaticResource Brush.TextMuted}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding FilePath}" Watermark="/path/to/appliance.ova" />
            <Button Grid.Column="1" Classes="ghost" Content="Browse…"
                    Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
          </Grid>

          <TextBlock Text="Systems" Foreground="{StaticResource Brush.TextMuted}"
                     IsVisible="{Binding HasPackage}" />
          <ItemsControl ItemsSource="{Binding SystemSummaries}" IsVisible="{Binding HasPackage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,0,2"
                           Foreground="{StaticResource Brush.TextMuted}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Destination SR" Foreground="{StaticResource Brush.TextMuted}" />
          <ComboBox ItemsSource="{Binding StorageRepositories}" SelectedItem="{Binding SelectedStorage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImportSrOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Home server" Foreground="{StaticResource Brush.TextMuted}" />
          <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImportHostOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Network" Foreground="{StaticResource Brush.TextMuted}" />
          <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="xena:Network">
                <TextBlock Text="{Binding name_label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <CheckBox Content="Verify manifest when present" IsChecked="{Binding VerifyManifest}" />
          <CheckBox Content="Start VMs after import" IsChecked="{Binding StartAfterImport}" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                  HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="cta" Content="Import" IsDefault="True"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding HasPackage}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
