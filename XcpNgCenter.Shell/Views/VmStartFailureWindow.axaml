<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XcpNgCenter.Shell.Views"
        x:Class="XcpNgCenter.Shell.Views.VmStartFailureWindow"
        x:DataType="views:VmStartFailureView"
        Title="{Binding Title}"
        Width="560" Height="420"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="16" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Text="{Binding Title}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Summary}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}"
                 Margin="0,0,0,12" />

      <Border Grid.Row="2"
              BorderBrush="{StaticResource Brush.StrokeSubtle}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="2*,*,3*"
                Margin="12,8"
                Opacity="0.85">
            <TextBlock Text="Host" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" />
            <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" />
            <TextBlock Grid.Column="2" Text="Reason" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" />
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="4,0,4,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:HostBootReasonRow">
                  <Border BorderBrush="{StaticResource Brush.StrokeSubtle}"
                          BorderThickness="0,1,0,0"
                          Padding="8,8">
                    <Grid ColumnDefinitions="2*,*,3*">
                      <TextBlock Text="{Binding HostName}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusLabel}"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource Brush.BrandOrange}" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Reason}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource Brush.TextMuted}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Classes="cta" Content="OK" MinWidth="100" IsDefault="True" IsCancel="True"
                Click="OnCloseClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
