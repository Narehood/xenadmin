<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels" xmlns:services="using:XcpNgCenter.Shell.Services"
        x:Class="XcpNgCenter.Shell.Views.DrEditorWindow" x:DataType="vm:DrEditorViewModel"
        Title="Disaster recovery" Width="820" Height="780" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgDeep}">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="6" Margin="0,0,0,16">
      <TextBlock Text="Disaster recovery" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding PoolName}" FontSize="16" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,8,0">
        <StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
          <TextBlock Text="Recovery metadata" FontWeight="SemiBold" />
          <Button Content="Discover metadata" Command="{Binding DiscoverCommand}" />
          <ComboBox x:Name="MetadataSelector" ItemsSource="{Binding Metadata}" SelectedItem="{Binding SelectedMetadata}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Recovery metadata database">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="services:DrMetadataOption">
              <StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Storage}" FontSize="11" /><TextBlock Text="{Binding Uuid}" FontSize="11" /></StackPanel>
            </DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Inspect metadata" Command="{Binding InspectCommand}" />
          <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" />
          <CheckBox x:Name="RehearsalCheckbox" IsChecked="{Binding IsRehearsal}">
            <TextBlock Text="Metadata rehearsal (halted, isolated, temporary VM records)" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{Binding ModeNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
          <TextBlock Text="VMs to recover" FontWeight="SemiBold" IsVisible="{Binding HasInspection}" />
          <ItemsControl ItemsSource="{Binding Vms}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DrVmDraft">
            <StackPanel Margin="0,0,0,8">
              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Replicated storage mappings" FontWeight="SemiBold" IsVisible="{Binding HasInspection}" />
          <TextBlock Text="Recovery uses attached replicas with the original SR UUID. It cannot copy or remap disks to unrelated storage." TextWrapping="Wrap" IsVisible="{Binding HasInspection}" />
          <ItemsControl ItemsSource="{Binding Storage}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DrStorageDraft">
            <StackPanel Spacing="4" Margin="0,0,0,8">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch" AutomationProperties.Name="Replicated storage destination">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="services:DrStorageOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="The required replicated SR is missing. Attach it and inspect metadata again." IsVisible="{Binding IsMissing}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Network mappings" FontWeight="SemiBold" IsVisible="{Binding HasInspection}" />
          <ItemsControl ItemsSource="{Binding Networks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DrNetworkDraft">
            <StackPanel Spacing="4" Margin="0,0,0,8">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch" AutomationProperties.Name="Recovery network destination">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="services:DrNetworkOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="No eligible network. Rehearsal needs an empty internal network without physical interfaces; create it before inspecting again." IsVisible="{Binding IsMissing}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" />
        <TextBlock Text="Recovery report" FontWeight="SemiBold" IsVisible="{Binding HasReport}" />
        <SelectableTextBlock Text="{Binding Report}" TextWrapping="Wrap" IsVisible="{Binding HasReport}" />
        <TextBlock Text="Closing this window does not clean up rehearsal VMs. Use Clean up rehearsal or remove the recorded halted VM records manually, preserving their disks. Operation reports remain in History."
                   IsVisible="{Binding CanCleanup}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Row="2" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
    </ScrollViewer>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ReviewButton" Content="Review" Command="{Binding ReviewCommand}" Margin="4" />
      <Button x:Name="RecoverButton" Content="Recover halted" Command="{Binding RecoverCommand}" Margin="4" />
      <Button x:Name="CleanupButton" Content="Clean up rehearsal" Command="{Binding CleanupCommand}" Margin="4" />
      <Button x:Name="CloseButton" Content="Close" Command="{Binding CloseCommand}" Margin="4" />
    </WrapPanel>
  </Grid>
</Window>
