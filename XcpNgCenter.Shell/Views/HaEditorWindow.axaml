<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels" xmlns:services="using:XcpNgCenter.Shell.Services"
        x:Class="XcpNgCenter.Shell.Views.HaEditorWindow" x:DataType="vm:HaEditorViewModel"
        Title="High availability" Width="760" Height="720" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgDeep}">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="6" Margin="0,0,0,16">
      <TextBlock Text="High availability" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding PoolName}" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PoolName}" />
      <TextBlock Text="{Binding CurrentState}" Foreground="{DynamicResource Brush.TextMuted}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,8,0">
        <StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
          <TextBlock Text="Change to make" />
          <ComboBox x:Name="OperationSelector" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="HA operation">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HaOperationOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Disabling HA stops automatic recovery after host failure. Existing VM restart policies and startup settings are retained."
                     IsVisible="{Binding IsDisabling}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
          <StackPanel Spacing="12" IsVisible="{Binding !IsDisabling}">
            <TextBlock Text="{Binding HostSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="HA uses network and shared-storage heartbeats. Lost heartbeats can fence or restart hosts. Recovery restarts eligible VMs and includes downtime."
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            <StackPanel Spacing="8" IsVisible="{Binding IsEnabling}">
              <TextBlock Text="Heartbeat storage" FontWeight="SemiBold" />
              <TextBlock Text="Run a server review to discover suitable shared storage, then select an SR and review the selection."
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
              <ComboBox x:Name="HeartbeatSelector" ItemsSource="{Binding HeartbeatCandidates}" SelectedItem="{Binding SelectedHeartbeatSr}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Heartbeat storage repository">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:HaSrOption">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Error}" IsVisible="{Binding !IsAvailable}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource Brush.AccentText}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="No heartbeat storage candidates are currently listed. Run a server review for current eligibility and reasons."
                         IsVisible="{Binding !HasHeartbeatCandidates}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding HeartbeatNotice}" IsVisible="{Binding HasHeartbeatNotice}"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
            </StackPanel>
            <TextBlock Text="The current heartbeat storage is retained. Selecting a different SR requires disabling and enabling HA."
                       IsVisible="{Binding IsConfiguring}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="Host failures to tolerate" FontWeight="SemiBold" />
            <TextBox x:Name="FailureToleranceText" Text="{Binding FailuresToTolerate}" Watermark="Host failure count"
                     AutomationProperties.Name="Host failures to tolerate" />
            <TextBlock Text="The server calculates capacity for your drafted VM restart policies. A tolerance of 0 reserves no host-failure capacity."
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="VM restart policies" FontWeight="SemiBold" />
            <TextBlock Text="A restart policy alone does not confirm protection. Review the server's agility and capacity results. Startup order and delay are preserved."
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
            <ListBox x:Name="VmPolicyList" ItemsSource="{Binding Vms}" Height="320" AutomationProperties.Name="VM restart policy drafts">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HaVmDraft">
                  <StackPanel Spacing="6" Margin="0,4,0,12">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Current policy:" Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="1" Margin="5,0,0,0" Text="{Binding CurrentPolicy}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PoolHaPriorityOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Select a supported policy explicitly to replace this unknown or legacy value."
                               IsVisible="{Binding RequiresExplicitPolicy}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
                    <TextBlock Text="{Binding StartupSettings}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding ReviewNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </StackPanel>
        <TextBlock Text="Server review" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Text="{Binding ReviewError}" IsVisible="{Binding HasReviewError}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
        <TextBlock Text="No settings have changed. You can review current capacity or edit the draft."
                   IsVisible="{Binding !HasChanges}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Text="Server checks do not replace controlled host-failure and recovery testing."
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Row="2" MaxHeight="110" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6" Margin="0,10,0,0">
        <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Classes="ghost" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" IsVisible="{Binding !IsReviewing}" />
      <Button Classes="ghost" Content="Cancel review" IsCancel="True" Command="{Binding CancelReviewCommand}" IsVisible="{Binding IsReviewing}" />
      <Button x:Name="ReviewHaButton" Content="Review server" Command="{Binding ReviewCommand}" />
      <Button x:Name="ApplyHaButton" Classes="cta" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" />
    </StackPanel>
  </Grid>
</Window>
