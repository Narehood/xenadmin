<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XcpNgCenter.Shell.ViewModels"
        x:Class="XcpNgCenter.Shell.Views.VmCloneWindow"
        x:DataType="vm:VmCloneViewModel"
        Title="Clone VM"
        Width="440" Height="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="20" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <StackPanel Spacing="12">
      <TextBlock Text="Clone VM" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Creates a fast clone on the same storage (VM.clone)."
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}" />
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.TextMuted}"
                 IsVisible="{Binding StatusMessage.Length}" />
      <TextBox Watermark="Name" Text="{Binding CloneName}" />
      <TextBox Watermark="Description"
               Text="{Binding CloneDescription}"
               AcceptsReturn="True"
               Height="72"
               TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="cta" Content="Clone" IsDefault="True" Command="{Binding CloneCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
