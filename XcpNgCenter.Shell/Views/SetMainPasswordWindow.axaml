<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XcpNgCenter.Shell.Views.SetMainPasswordWindow"
        Title="Set main password"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgDeep}">
  <Border Margin="16" Padding="20"
          Background="#99161C22"
          BorderBrush="{StaticResource Brush.StrokeSubtle}"
          BorderThickness="1"
          CornerRadius="10">
    <StackPanel Spacing="12">
      <TextBlock Text="Set main password" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="The main password protects all your saved server login credentials. You will need to enter this password at the beginning of each session."
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{StaticResource Brush.TextMuted}" />
      <TextBox x:Name="PasswordBox"
               Watermark="New main password"
               PasswordChar="•" />
      <TextBox x:Name="ConfirmBox"
               Watermark="Re-enter main password"
               PasswordChar="•" />
      <TextBlock x:Name="ErrorText"
                 Foreground="#E07070"
                 FontSize="12"
                 TextWrapping="Wrap"
                 IsVisible="False" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        <Button Classes="cta" Content="OK" IsDefault="True" Click="OnOkClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
